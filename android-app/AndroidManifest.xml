<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.dsh.spike"
    android:versionCode="3"
    android:versionName="0.2.0-m2">
    <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="34"/>
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Lets the user grant all-files access in Settings so the node runtime
         (same uid) can browse/read real phone storage, not just app-private dirs. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"/>
    <!-- Package visibility (API 30+): without this the PM hides everything but
         a default handful, so app_list sees ~11 of the dozens of installed apps. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"/>
    <application
        android:label="DSH"
        android:extractNativeLibs="true"
        android:debuggable="true"
        android:networkSecurityConfig="@xml/network_security_config">
        <!-- singleTop so ACTION_SEND shares land in onNewIntent of the live
             instance instead of stacking duplicate activities. -->
        <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- M2 share-sheet entry: other apps "share text" into DSH. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="text/*"/>
            </intent-filter>
        </activity>
        <service
            android:name=".DshService"
            android:exported="false"
            android:foregroundServiceType="dataSync"/>
    </application>
</manifest>
