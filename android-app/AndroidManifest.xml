<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.dsh.spike"
    android:versionCode="2"
    android:versionName="0.1.0-m1">
    <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="34"/>
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Lets the user grant all-files access in Settings so the node runtime
         (same uid) can browse/read real phone storage, not just app-private dirs. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"/>
    <application
        android:label="DSH"
        android:extractNativeLibs="true"
        android:debuggable="true"
        android:networkSecurityConfig="@xml/network_security_config">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <service
            android:name=".DshService"
            android:exported="false"
            android:foregroundServiceType="dataSync"/>
    </application>
</manifest>
